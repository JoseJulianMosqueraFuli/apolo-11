# Grafana admin credentials template.
#
# IMPORTANT: Do NOT commit real credentials to version control.
# This file uses the ".example" suffix so it is ignored by `kubectl apply -f k8s/`.
#
# Recommended (no secrets written to disk): create the Secret directly with
# strong, randomly generated values:
#
#   kubectl create secret generic grafana-auth \
#     --from-literal=admin-user="admin" \
#     --from-literal=admin-password="$(openssl rand -base64 24)"
#
# Alternatively, copy this template, set strong values and apply it manually:
#
#   cp k8s/grafana-secret.yaml.example k8s/grafana-secret.yaml
#   # edit k8s/grafana-secret.yaml, then:
#   kubectl apply -f k8s/grafana-secret.yaml
#
# The real k8s/grafana-secret.yaml file is git-ignored.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-auth
type: Opaque
stringData:
  admin-user: admin
  admin-password: CHANGE_ME
