# RabbitMQ credentials template.
#
# IMPORTANT: Do NOT commit real credentials to version control.
# This file uses the ".example" suffix so it is ignored by `kubectl apply -f k8s/`.
#
# Recommended (no secrets written to disk): create the Secret directly with
# strong, randomly generated values:
#
#   kubectl create secret generic rabbitmq-auth \
#     --from-literal=username="apolo-$(openssl rand -hex 4)" \
#     --from-literal=password="$(openssl rand -base64 24)"
#
# Alternatively, copy this template, set strong values and apply it manually:
#
#   cp k8s/rabbitmq-secret.yaml.example k8s/rabbitmq-secret.yaml
#   # edit k8s/rabbitmq-secret.yaml, then:
#   kubectl apply -f k8s/rabbitmq-secret.yaml
#
# The real k8s/rabbitmq-secret.yaml file is git-ignored.
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-auth
type: Opaque
stringData:
  username: CHANGE_ME
  password: CHANGE_ME
