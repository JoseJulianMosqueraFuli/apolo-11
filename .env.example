# Copy this file to .env and set strong, unique values.
# NEVER commit the real .env file (it is gitignored).

# --- RabbitMQ credentials ---
# Avoid the default "guest" account. Use a dedicated user and a strong password.
RABBITMQ_USER=apolo
RABBITMQ_PASS=change-me-strong-password

# --- Grafana admin credentials ---
# Avoid the default admin/admin.
GRAFANA_ADMIN_USER=apolo_admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
